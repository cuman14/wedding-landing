---
// src/components/WeatherCard.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const WEDDING_DATE = "2026-10-10";
const DAY_AFTER_WEDDING = "2026-10-11";
// "Comienza" en InfoCards.astro: 13:30h, hora en la que recibimos a los invitados.
const RECEPTION_HOUR = 13;
const LATITUDE = 39.9925;
const LONGITUDE = -4.226;
const TIMEZONE = "Europe/Madrid";
const CACHE_TTL_MS = 6 * 60 * 60 * 1000; // 6h

interface HourlyWeather {
  hour: string;
  temp: number;
  feelsLike: number;
  rainChance: number;
}

interface WeatherResult {
  weatherCode: number;
  tempMax: number;
  tempMin: number;
  feelsLikeMax: number;
  feelsLikeMin: number;
  windMax: number;
  rainChance: number;
  hourly: HourlyWeather[];
}

// Persisted across warm serverless invocations on the same instance.
const globalCache = globalThis as unknown as {
  __weatherCache?: { data: WeatherResult | null; fetchedAt: number };
};

const WEATHER_ICONS: Record<string, string> = {
  sunny: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>`,
  partlyCloudy: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><path d="M7 7a3 3 0 1 1 4.2 2.7"/><path d="M7 4v1M3.5 7.5h1M11 4l-.7.7M3.2 4.2l.7.7"/><path d="M6.5 19a3.5 3.5 0 0 1 .4-7 4.5 4.5 0 0 1 8.6 1.7A3 3 0 0 1 15 19H6.5Z"/></svg>`,
  cloudy: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><path d="M6.5 19a4 4 0 0 1 .3-8 5 5 0 0 1 9.6 2A3.5 3.5 0 0 1 16 19H6.5Z"/></svg>`,
  foggy: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><path d="M6.5 15a4 4 0 0 1 .3-8 5 5 0 0 1 9.6 2A3.5 3.5 0 0 1 16 15H6.5Z"/><path d="M4 19h16M6 22h12"/></svg>`,
  rainLight: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><path d="M6.5 14a4 4 0 0 1 .3-8 5 5 0 0 1 9.6 2A3.5 3.5 0 0 1 16 14H6.5Z"/><path d="M8 18v2M12 18v2M16 18v2"/></svg>`,
  rain: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><path d="M6.5 13a4 4 0 0 1 .3-8 5 5 0 0 1 9.6 2A3.5 3.5 0 0 1 16 13H6.5Z"/><path d="M7 17l-1 3M11 17l-1 3M15 17l-1 3"/></svg>`,
  snow: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><path d="M6.5 13a4 4 0 0 1 .3-8 5 5 0 0 1 9.6 2A3.5 3.5 0 0 1 16 13H6.5Z"/><path d="M8 18v3M6.5 19.5h3M13 18v3M11.5 19.5h3M16 18v2"/></svg>`,
  thunderstorm: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><path d="M6.5 13a4 4 0 0 1 .3-8 5 5 0 0 1 9.6 2A3.5 3.5 0 0 1 16 13H6.5Z"/><path d="M12.5 14l-3 5h2.5l-1.5 4 4-5.5h-2.5l1.5-3.5Z" fill="currentColor" stroke="none"/></svg>`,
};

function weatherCodeToSvg(code: number): string {
  if (code === 0) return WEATHER_ICONS.sunny;
  if (code === 1 || code === 2) return WEATHER_ICONS.partlyCloudy;
  if (code === 3) return WEATHER_ICONS.cloudy;
  if (code === 45 || code === 48) return WEATHER_ICONS.foggy;
  if (code >= 51 && code <= 67) return WEATHER_ICONS.rainLight;
  if (code >= 71 && code <= 77) return WEATHER_ICONS.snow;
  if (code >= 80 && code <= 82) return WEATHER_ICONS.rain;
  if (code >= 95) return WEATHER_ICONS.thunderstorm;
  return WEATHER_ICONS.sunny;
}

type WeatherCondition =
  | "sunny"
  | "partlyCloudy"
  | "cloudy"
  | "foggy"
  | "rain"
  | "snow"
  | "storm";

function weatherCodeToCondition(code: number): WeatherCondition {
  if (code === 1 || code === 2) return "partlyCloudy";
  if (code === 3) return "cloudy";
  if (code === 45 || code === 48) return "foggy";
  if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return "rain";
  if (code >= 71 && code <= 77) return "snow";
  if (code >= 95) return "storm";
  return "sunny";
}

function daysUntil(dateStr: string): number {
  const today = new Date(new Date().toISOString().slice(0, 10) + "T00:00:00Z");
  const target = new Date(dateStr + "T00:00:00Z");
  return Math.round((target.getTime() - today.getTime()) / 86400000);
}

async function fetchForecast(): Promise<WeatherResult | null> {
  const url =
    `https://api.open-meteo.com/v1/forecast?latitude=${LATITUDE}&longitude=${LONGITUDE}` +
    `&daily=weathercode,temperature_2m_max,temperature_2m_min,apparent_temperature_max,apparent_temperature_min,windspeed_10m_max,precipitation_probability_max` +
    `&hourly=temperature_2m,apparent_temperature,precipitation_probability` +
    `&timezone=${encodeURIComponent(TIMEZONE)}&start_date=${WEDDING_DATE}&end_date=${DAY_AFTER_WEDDING}`;

  const res = await fetch(url);
  if (!res.ok) return null;
  const data = await res.json();
  const i = data?.daily?.time?.indexOf(WEDDING_DATE);
  if (i === undefined || i < 0 || data.daily.temperature_2m_max[i] == null) {
    return null;
  }

  const hourly: HourlyWeather[] = (data.hourly?.time ?? [])
    .map((time: string, idx: number) => ({
      date: time.slice(0, 10),
      hour: Number(time.slice(11, 13)),
      temp: Math.round(data.hourly.temperature_2m[idx]),
      feelsLike: Math.round(data.hourly.apparent_temperature[idx]),
      rainChance: Math.round(data.hourly.precipitation_probability[idx]),
    }))
    .filter(
      (h: { date: string; hour: number }) =>
        (h.date === WEDDING_DATE && h.hour >= RECEPTION_HOUR) ||
        (h.date === DAY_AFTER_WEDDING && h.hour === 0),
    )
    .map(
      (h: {
        hour: number;
        temp: number;
        feelsLike: number;
        rainChance: number;
      }) => ({
        hour: `${String(h.hour).padStart(2, "0")}h`,
        temp: h.temp,
        feelsLike: h.feelsLike,
        rainChance: h.rainChance,
      }),
    );

  return {
    weatherCode: data.daily.weathercode[i],
    tempMax: Math.round(data.daily.temperature_2m_max[i]),
    tempMin: Math.round(data.daily.temperature_2m_min[i]),
    feelsLikeMax: Math.round(data.daily.apparent_temperature_max[i]),
    feelsLikeMin: Math.round(data.daily.apparent_temperature_min[i]),
    windMax: Math.round(data.daily.windspeed_10m_max[i]),
    rainChance: Math.round(data.daily.precipitation_probability_max[i]),
    hourly,
  };
}

async function getWeather(): Promise<WeatherResult | null> {
  const cached = globalCache.__weatherCache;
  if (cached && Date.now() - cached.fetchedAt < CACHE_TTL_MS) {
    return cached.data;
  }

  let data: WeatherResult | null = null;
  try {
    const diff = daysUntil(WEDDING_DATE);
    if (diff >= 0 && diff <= 15) {
      data = await fetchForecast();
    }
  } catch {
    data = null;
  }

  globalCache.__weatherCache = { data, fetchedAt: Date.now() };
  return data;
}

const weather = await getWeather();
const condition = weatherCodeToCondition(weather?.weatherCode ?? 0);
---

<section
  class="relative px-6 pt-8 md:pt-10 pb-2 md:pb-4 bg-background-light dark:bg-background-dark overflow-hidden"
>
  <div aria-hidden="true" class={`weather-bg weather-bg--${condition}`}>
    {(condition === "sunny" || condition === "partlyCloudy") && <div class="wx-sun" />}
    {(condition === "partlyCloudy" || condition === "cloudy" || condition === "rain" || condition === "storm") && (
      <>
        <div class="wx-cloud wx-cloud--1" />
        <div class="wx-cloud wx-cloud--2" />
        <div class="wx-cloud wx-cloud--3" />
      </>
    )}
    {condition === "foggy" && (
      <>
        <div class="wx-fog wx-fog--1" />
        <div class="wx-fog wx-fog--2" />
      </>
    )}
    {(condition === "rain" || condition === "storm") && (
      <>
        <div class="wx-rain" />
        <div class="wx-rain wx-rain--2" />
      </>
    )}
    {condition === "storm" && <div class="wx-flash" />}
    {condition === "snow" && (
      <>
        <div class="wx-snow" />
        <div class="wx-snow wx-snow--2" />
      </>
    )}
  </div>
  <div class="max-w-6xl mx-auto relative z-10">
<div id="weather-banner" class="w-full relative flex flex-col gap-6 py-2">
  <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-10 relative">
    <div class="flex items-center gap-4 md:min-w-[220px]">
      <div
        class="text-primary w-10 h-10 shrink-0"
        set:html={weather ? weatherCodeToSvg(weather.weatherCode) : WEATHER_ICONS.sunny}
      />
      <div>
        <h4
          class="font-body text-xl font-bold text-text-main-light dark:text-text-main-dark"
        >
          {t("weather.title")}
        </h4>
        <p class="text-gray-500 dark:text-gray-400 text-xs font-light">
          {t("weather.subtitle")}
        </p>
      </div>
    </div>

    {
      weather ? (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8 text-center flex-1">
          <div class="flex flex-col items-center gap-1">
            <span class="material-symbols-outlined text-gray-400 text-lg">
              thermostat
            </span>
            <span class="font-body text-lg md:text-xl font-bold text-text-main-light dark:text-text-main-dark tabular-nums">
              {weather.tempMin}° / {weather.tempMax}°
            </span>
            <span class="text-[10px] uppercase tracking-widest text-gray-400">
              {t("weather.temp")}
            </span>
          </div>
          <div class="flex flex-col items-center gap-1">
            <span class="material-symbols-outlined text-gray-400 text-lg">
              device_thermostat
            </span>
            <span class="font-body text-lg md:text-xl font-bold text-text-main-light dark:text-text-main-dark tabular-nums">
              {weather.feelsLikeMin}° / {weather.feelsLikeMax}°
            </span>
            <span class="text-[10px] uppercase tracking-widest text-gray-400">
              {t("weather.feels_like")}
            </span>
          </div>
          <div class="flex flex-col items-center gap-1">
            <span class="material-symbols-outlined text-gray-400 text-lg">
              air
            </span>
            <span class="font-body text-lg md:text-xl font-bold text-text-main-light dark:text-text-main-dark tabular-nums">
              {weather.windMax} km/h
            </span>
            <span class="text-[10px] uppercase tracking-widest text-gray-400">
              {t("weather.wind")}
            </span>
          </div>
          <div class="flex flex-col items-center gap-1">
            <span class="material-symbols-outlined text-gray-400 text-lg">
              water_drop
            </span>
            <span class="font-body text-lg md:text-xl font-bold text-text-main-light dark:text-text-main-dark tabular-nums">
              {weather.rainChance}%
            </span>
            <span class="text-[10px] uppercase tracking-widest text-gray-400">
              {t("weather.rain")}
            </span>
          </div>
        </div>
      ) : (
        <p class="text-gray-500 dark:text-gray-400 text-sm font-light flex-1">
          {t("weather.error")}
        </p>
      )
    }

    {
      weather && (
        <p class="text-gray-400 dark:text-gray-500 text-[11px] font-light italic md:min-w-[180px] md:text-right">
          {t("weather.forecast_note")}
        </p>
      )
    }
  </div>

  {
    weather && weather.hourly.length > 0 && (
      <div class="relative border-t border-primary/10 dark:border-white/10 pt-5">
        <p class="text-[10px] uppercase tracking-widest text-gray-400 mb-3">
          {t("weather.hourly_title")}
        </p>
        <div class="flex gap-4 overflow-x-auto pb-1">
          {weather.hourly.map((h) => (
            <div class="flex flex-col items-center gap-1 shrink-0 min-w-[56px]">
              <span class="text-[11px] font-body font-semibold text-gray-400 tabular-nums">
                {h.hour}
              </span>
              <span class="font-body text-sm font-bold text-text-main-light dark:text-text-main-dark tabular-nums">
                {h.temp}°
              </span>
              <span class="text-[10px] text-gray-400 tabular-nums">
                {t("weather.feels_like_short")} {h.feelsLike}°
              </span>
              <span class="flex items-center gap-0.5 text-[11px] text-primary tabular-nums">
                <span class="material-symbols-outlined text-[13px] leading-none">
                  water_drop
                </span>
                {h.rainChance}%
              </span>
            </div>
          ))}
        </div>
      </div>
    )
  }
</div>
  </div>
</section>

{
  weather && (
    <div
      id="weather-sticky"
      aria-hidden="true"
      class="fixed top-16 left-0 w-full z-40 -translate-y-full opacity-0 pointer-events-none transition-all duration-300 bg-background-light/95 dark:bg-background-dark/95 backdrop-blur-md border-b border-pearl-grey dark:border-white/10 shadow-sm"
    >
      <a
        href="#weather-banner"
        class="max-w-6xl mx-auto px-4 md:px-6 py-2 flex items-center justify-center gap-3 md:gap-6 text-xs md:text-sm font-body text-text-main-light dark:text-text-main-dark"
      >
        <span
          class="text-primary w-6 h-6 shrink-0"
          set:html={weatherCodeToSvg(weather.weatherCode)}
        />
        <span class="hidden sm:inline font-semibold">{t("weather.title")}</span>
        <span class="flex items-center gap-1 font-bold tabular-nums">
          <span class="material-symbols-outlined text-base text-gray-400">thermostat</span>
          {weather.tempMin}° / {weather.tempMax}°
        </span>
        <span class="hidden md:flex items-center gap-1 tabular-nums">
          <span class="material-symbols-outlined text-base text-gray-400">device_thermostat</span>
          {weather.feelsLikeMin}° / {weather.feelsLikeMax}°
        </span>
        <span class="flex items-center gap-1 tabular-nums">
          <span class="material-symbols-outlined text-base text-primary">water_drop</span>
          {weather.rainChance}%
        </span>
        <span class="hidden sm:flex items-center gap-1 tabular-nums">
          <span class="material-symbols-outlined text-base text-gray-400">air</span>
          {weather.windMax} km/h
        </span>
      </a>
    </div>
  )
}

<script>
  const banner = document.getElementById("weather-banner");
  const sticky = document.getElementById("weather-sticky");
  if (banner && sticky) {
    const HEADER_HEIGHT = 64;
    const show = (visible: boolean) => {
      sticky.classList.toggle("-translate-y-full", !visible);
      sticky.classList.toggle("opacity-0", !visible);
      sticky.classList.toggle("pointer-events-none", !visible);
    };
    new IntersectionObserver(
      ([entry]) => show(!entry.isIntersecting && entry.boundingClientRect.top < 0),
      { rootMargin: `-${HEADER_HEIGHT}px 0px 0px 0px` },
    ).observe(banner);
  }
</script>

---
import Layout from "../layouts/Layout.astro";
import Countdown from "./Countdown.astro";
import FAQ from "./FAQ.astro";
import Footer from "./Footer.astro";
import GiftDetails from "./GiftDetails.astro";
import Hero from "./Hero.astro";
import InfoCards from "./InfoCards.astro";
import Progress from "./Progress.astro";
import SeccionFormulario from "./SeccionFormulario.astro";
import WeatherCard from "./WeatherCard.astro";
import VideoSection from "./VideoSection.astro";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
---

<Layout>
  <!--  <IntroGate /> -->
  <main class="flex flex-col min-h-screen w-full">
    <!-- <Hero /> -->
    <WeatherCard />
    <InfoCards />
    <GiftDetails />
    <VideoSection />
    <!-- <SeccionFormulario /> -->
    <Countdown />
    <Progress />
    <FAQ />
    <Footer />
  </main>
</Layout>

---
import IntroGate from "../../../components/IntroGate.astro";
import Layout from "../../../layouts/Layout.astro";
import { invitacionesLectura } from "../../../data/lectura";

export const prerender = false;

const { persona } = Astro.params;

const invitacion = invitacionesLectura["lectura2026"];

if (!invitacion) {
  return Astro.redirect("/es/");
}

const personaData = invitacion.personas.find(
  (p) => p.id.toLowerCase() === persona?.toLowerCase()
);

if (!personaData) {
  return Astro.redirect("/es/");
}

const site = "https://www.marinayoswald.es";
const message = `Hola, <strong>${personaData.nombre}</strong> 🙏<br/><br/>${personaData.message.replace(/\n/g, "<br/>")}`;
const metaTitle = `💌 ${invitacion.title}`;
const metaDescription = `${personaData.nombre}, tienes un mensaje muy especial de Marina & Oswald para ti.`;
const ogImage = `${site}${personaData.foto}`;
const ogUrl = `${site}/megustariaque/lectura/${personaData.id}`;
---

<Layout title={metaTitle} description={metaDescription} image={ogImage} canonicalUrl={ogUrl}>
  <IntroGate message={message} photo={personaData.foto} staticMode={true} />
</Layout>